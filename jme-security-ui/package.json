{
  "name": "jme-security-ui",
  "version": "13.0.3",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run check-licenses && npm run generate-license-file && ng build --base-href /jme-security-scs/",
    "build-dev": "npm run check-licenses && npm run generate-license-file && ng build -c development --base-href /jme-security-scs/",
    "build-prod": "npm run check-licenses && npm run generate-license-file && ng build -c production --base-href /jme-security-scs/",
    "test": "ng test",
    "test-ci": "ng test -u --watch=false --run-in-band --force-exit --collect-coverage=false -c production",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "pretty:ts": "pretty-quick --parser mdx",
    "pretty:scss": "stylelint \"src/**/*.scss\" --fix",
    "pretty": "npm run pretty:ts && npm run pretty:scss",
    "check-licenses": "jeap-frontend-license-checker",
    "generate-license-file": "jeap-frontend-license-checker notices && jeap-frontend-license-checker notices --out src/assets/THIRD-PARTY-LICENSES.md --texts folder --texts-dir third-party-licenses"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "@ngx-translate/core": "^17.0.0",
    "@oblique/oblique": "15.4.4",
    "@popperjs/core": "^2.11.8",
    "@quadrel-enterprise-ui/auth": "21.2.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "angular-oauth2-oidc": "^20.0.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "21.0.4",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@jeap/jeap-frontend-license-checker": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "jest-sonar-reporter": "2.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@angular-devkit/build-angular": "21.2.29",
    "angular-eslint": "21.4.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "fast-uri": "4.2.3",
    "deepmerge-ts": "8.0.2",
    "uuid": "14.0.3"
  },
  "husky": {
    "hooks": {
      "commit-msg": "node scripts/hook.commit-rules",
      "pre-commit": "lint-staged -v"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "pretty-quick"
    ],
    "*.scss": [
      "npm run pretty:scss"
    ]
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
