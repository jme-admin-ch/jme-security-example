{
  "name": "jme-security-ui",
  "version": "13.0.3",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run check-licenses && npm run generate-license-file && ng build --base-href /jme-security-scs/",
    "build-dev": "npm run check-licenses && npm run generate-license-file && ng build -c development --base-href /jme-security-scs/",
    "build-prod": "npm run check-licenses && npm run generate-license-file && ng build -c production --base-href /jme-security-scs/",
    "test": "ng test",
    "test-ci": "ng test -u --watch=false --run-in-band --force-exit --collect-coverage=false -c production",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "pretty:ts": "pretty-quick --parser mdx",
    "pretty:scss": "stylelint \"src/**/*.scss\" --fix",
    "pretty": "npm run pretty:ts && npm run pretty:scss",
    "check-licenses": "jeap-frontend-license-checker",
    "generate-license-file": "jeap-frontend-license-checker notices"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@ngrx/store": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@popperjs/core": "^2.11.8",
    "@quadrel-enterprise-ui/auth": "20.1.3",
    "@quadrel-enterprise-ui/browser-check": "20.0.1",
    "@quadrel-enterprise-ui/framework": "20.35.0",
    "@quadrel-enterprise-ui/language": "20.0.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0",
    "@angular-eslint/builder": "^20.0",
    "@angular-eslint/eslint-plugin": "^20.0",
    "@angular-eslint/eslint-plugin-template": "^20.0",
    "@angular-eslint/schematics": "^20.0",
    "@angular-eslint/template-parser": "^20.0",
    "@angular/build": "^20.0",
    "@angular/cli": "^20.0",
    "@angular/compiler-cli": "20.3.27",
    "@jeap/jeap-frontend-license-checker": "^1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "ajv": "^8.18.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "4.1.2",
    "deepmerge-ts": "8.0.1",
    "uuid": "14.0.2"
  },
  "husky": {
    "hooks": {
      "commit-msg": "node scripts/hook.commit-rules",
      "pre-commit": "lint-staged -v"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "pretty-quick"
    ],
    "*.scss": [
      "npm run pretty:scss"
    ]
  }
}
